{% comment %}
  Timekettle product card — дизайн карточек «Find Your Timekettle» (Figma, главная),
  дефолтная карточка товара по всему сайту: сетка коллекции, поиск, related products,
  featured collection, collage, и сама секция featured-products.

  Параметры Dawn сохранены, чтобы все вызовы работали без изменений.

  Accepts:
  - card_product: {Object} Product (optional — без него рендерится плейсхолдер)
  - show_price: {Boolean} Показывать цену. Default: true (featured-products передаёт false — в макете цены нет)
  - show_blurb: {Boolean} Показывать короткое описание. Default: true
  - show_status: {Boolean} Пилюля Sold out / Sale на фото. Default: true (featured-products передаёт false)
  - lazy_load: {Boolean} Default: true
  - skip_styles: {Boolean} Не подключать component-price.css повторно в цикле
  - section_id: {String} ID секции (для id заголовка)
  - product_view_context: {String} Контекст аналитики: 'collection' / 'search' / 'recommendation'
  - placeholder_image: {String} SVG-плейсхолдер, когда товара нет
  - placeholder_blurb: {String} Текст плейсхолдера (optional)

  Принимаются и игнорируются (у карточки один фиксированный вид): media_aspect_ratio, image_shape,
  show_secondary_image, show_vendor, show_rating, quick_add, extend_height, horizontal_class,
  horizontal_quick_add. Quick add убран — кнопка ведёт на страницу товара.

  Контент карточки — метаполя товара (фолбэки в скобках):
    custom.card_title       — короткое имя, «W4 Pro» (название товара)
    custom.card_badge       — пилюля, «Best for Travel» (нет пилюли)
    custom.card_badge_icon  — chat / star / plane / truck / check / heart / lock / discount (star)
    custom.card_blurb       — 1–2 предложения (описание товара, 14 слов)

  Размеры зависят от ширины самой карточки (container queries), а не от вьюпорта:
  ≥380px — десктоп макета (заголовок 28, текст 18/26), <380px — мобайл макета (20 / 16, медиа 7:6),
  <240px — узкие сетки в 2 колонки на телефоне.

  Стили — assets/component-card-product.css (подключены в layout/theme.liquid).
{% endcomment %}

{%- unless skip_styles or show_price == false -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign short_title = card_product.metafields.custom.card_title.value
    assign card_title = short_title | default: card_product.title
    # «Shop NEW T1 Handheld Translator Device» ломает пилюлю в 3 строки — без короткого имени пишем «Shop now»
    assign button_label = 'Shop now'
    if short_title != blank
      assign button_label = 'Shop ' | append: short_title
    endif
    assign badge = card_product.metafields.custom.card_badge.value
    assign badge_icon = card_product.metafields.custom.card_badge_icon.value | default: 'star' | downcase | strip
    assign blurb = card_product.metafields.custom.card_blurb.value
    if blurb == blank
      assign blurb = card_product.description | strip_html | truncatewords: 14
    endif

    assign img_loading = 'lazy'
    if lazy_load == false
      assign img_loading = 'eager'
    endif

    assign status = blank
    if show_status == false
      assign status = blank
    elsif card_product.available == false
      assign status = 'products.product.sold_out' | t
    elsif card_product.compare_at_price > card_product.price
      assign status = 'products.product.on_sale' | t
    endif
  -%}

  <product-component
    class="fp-card-host"
    view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}"
  >
    <div class="fp-card{% if card_product.available == false %} fp-card--sold-out{% endif %}">
      <a href="{{ card_product.url }}" class="fp-card__media" tabindex="-1" aria-hidden="true">
        {%- if badge != blank -%}
          <span class="fp-card__badge">
            <span class="fp-card__badge-icon">
              {%- case badge_icon -%}
                {%- when 'truck' -%}{{ 'icon-truck.svg' | inline_asset_content }}
                {%- when 'check' -%}{{ 'icon-check-mark.svg' | inline_asset_content }}
                {%- when 'star' -%}{{ 'icon-star.svg' | inline_asset_content }}
                {%- when 'heart' -%}{{ 'icon-heart.svg' | inline_asset_content }}
                {%- when 'chat' -%}{{ 'icon-chat-bubble.svg' | inline_asset_content }}
                {%- when 'lock' -%}{{ 'icon-lock.svg' | inline_asset_content }}
                {%- when 'plane' -%}{{ 'icon-plane.svg' | inline_asset_content }}
                {%- when 'discount' -%}{{ 'icon-discount.svg' | inline_asset_content }}
                {%- else -%}{{ 'icon-star.svg' | inline_asset_content }}
              {%- endcase -%}
            </span>
            <span class="fp-card__badge-label">{{ badge | escape }}</span>
          </span>
        {%- endif -%}

        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 900
            | image_tag:
              loading: img_loading,
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 90vw',
              class: 'fp-card__image',
              alt: card_product.featured_media.alt | default: card_product.title | escape
          }}
        {%- else -%}
          {{ placeholder_image | default: 'product-apparel-1' | placeholder_svg_tag: 'fp-card__placeholder' }}
        {%- endif -%}

        {%- if status != blank -%}
          <span class="fp-card__status">{{ status }}</span>
        {%- endif -%}
      </a>

      <div class="fp-card__body">
        <h3 class="fp-card__title" id="title-{{ section_id }}-{{ card_product.id }}">
          <a href="{{ card_product.url }}">{{ card_title | escape }}</a>
        </h3>

        {%- unless show_price == false -%}
          <div class="fp-card__price">
            {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
          </div>
        {%- endunless -%}

        {%- if blurb != blank -%}
          {%- unless show_blurb == false -%}
            <p class="fp-card__blurb">{{ blurb }}</p>
          {%- endunless -%}
        {%- endif -%}

        <a
          href="{{ card_product.url }}"
          class="button button--primary fp-card__button"
          aria-labelledby="title-{{ section_id }}-{{ card_product.id }}"
        >
          {{ button_label | escape }}
        </a>
      </div>
    </div>
  </product-component>
{%- else -%}
  <div class="fp-card-host">
    <div class="fp-card">
      <div class="fp-card__media">
        {{ placeholder_image | default: 'product-apparel-1' | placeholder_svg_tag: 'fp-card__placeholder' }}
      </div>
      <div class="fp-card__body">
        <h3 class="fp-card__title">{{ 'onboarding.product_title' | t }}</h3>
        {%- unless show_price == false -%}
          <div class="fp-card__price">
            {% render 'price', placeholder: true, show_compare_at_price: true %}
          </div>
        {%- endunless -%}
        {%- if placeholder_blurb != blank -%}
          <p class="fp-card__blurb">{{ placeholder_blurb }}</p>
        {%- endif -%}
        <span class="button button--primary fp-card__button">Shop now</span>
      </div>
    </div>
  </div>
{%- endif -%}
