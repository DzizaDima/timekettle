{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="FeatureBar-{{ section.id }}"
  class="feature-bar color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.show_line_separator %} feature-bar--bottom-border{% endif %}"
  style="--feature-bar-count: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="page-width">
    <ul class="feature-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="feature-bar__icon svg-wrapper" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}{{ 'icon-truck.svg' | inline_asset_content }}
                {%- when 'check' -%}{{ 'icon-check-mark.svg' | inline_asset_content }}
                {%- when 'tick' -%}{{ 'icon-tick.svg' | inline_asset_content }}
                {%- when 'star' -%}{{ 'icon-star.svg' | inline_asset_content }}
                {%- when 'heart' -%}{{ 'icon-heart.svg' | inline_asset_content }}
                {%- when 'fire' -%}{{ 'icon-fire.svg' | inline_asset_content }}
                {%- when 'chat' -%}{{ 'icon-chat-bubble.svg' | inline_asset_content }}
                {%- when 'question' -%}{{ 'icon-question-mark.svg' | inline_asset_content }}
                {%- when 'lock' -%}{{ 'icon-lock.svg' | inline_asset_content }}
                {%- when 'return' -%}{{ 'icon-return.svg' | inline_asset_content }}
                {%- when 'stopwatch' -%}{{ 'icon-stopwatch.svg' | inline_asset_content }}
                {%- when 'plane' -%}{{ 'icon-plane.svg' | inline_asset_content }}
                {%- when 'map-pin' -%}{{ 'icon-map-pin.svg' | inline_asset_content }}
                {%- when 'discount' -%}{{ 'icon-discount.svg' | inline_asset_content }}
              {%- endcase -%}
            </span>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <span class="feature-bar__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .feature-bar {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .feature-bar .feature-bar__item {
    color: rgb(var(--color-foreground));
  }

  .feature-bar--bottom-border {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  /* full-bleed bar — tighter gutters than the page default so 2 items fit on mobile */
  .feature-bar .page-width {
    padding-left: 1.2rem;
    padding-right: 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .feature-bar .page-width {
      padding-left: 6rem;
      padding-right: 6rem;
    }
  }

  /* --- Mobile: swipeable / auto-rotating slider, 2 items per view --- */
  .feature-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }

  .feature-bar__list::-webkit-scrollbar {
    display: none;
  }

  .feature-bar__item {
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0 0.6rem;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* each snap position shows a pair: [1,2], [3,4] ... */
  .feature-bar__item:nth-child(odd) {
    scroll-snap-align: start;
  }

  .feature-bar__icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .feature-bar__icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .feature-bar__icon svg path {
    fill: currentColor;
  }

  /* --- Desktop: static row of all items, centred --- */
  @media screen and (min-width: 750px) {
    .feature-bar__list {
      display: grid;
      grid-template-columns: repeat(var(--feature-bar-count, 4), auto);
      justify-content: center;
      gap: 3.2rem;
      overflow: visible;
      scroll-snap-type: none;
    }

    .feature-bar__item,
    .feature-bar__item:nth-child(odd),
    .feature-bar__item:nth-child(even) {
      flex: initial;
      justify-content: flex-start;
      padding: 0;
      font-size: 1.4rem;
      scroll-snap-align: none;
    }

    .feature-bar__icon svg {
      width: 2rem;
      height: 2rem;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('FeatureBar-{{ section.id }}');
    if (!root) return;
    var list = root.querySelector('.feature-bar__list');
    if (!list) return;

    var mq = window.matchMedia('(max-width: 749px)');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var designMode = window.Shopify && window.Shopify.designMode;
    var timer = null;
    var DELAY = 3500;

    function slides() {
      return Math.ceil(list.children.length / 2);
    }

    function advance() {
      if (!mq.matches || slides() <= 1) return;
      var step = list.clientWidth;
      var current = Math.round(list.scrollLeft / step);
      var next = current + 1 >= slides() ? 0 : current + 1;
      list.scrollTo({ left: next * step, behavior: 'smooth' });
    }

    function start() {
      stop();
      if (mq.matches && !designMode && !reduce.matches && slides() > 1) {
        timer = setInterval(advance, DELAY);
      }
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    list.addEventListener('pointerdown', stop);
    list.addEventListener('pointerup', start);
    list.addEventListener('pointercancel', start);
    list.addEventListener('mouseenter', stop);
    list.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', function () {
      document.hidden ? stop() : start();
    });
    (mq.addEventListener ? mq.addEventListener('change', start) : mq.addListener(start));

    start();
  })();
</script>

{% schema %}
{
  "name": "Feature bar",
  "class": "section-feature-bar",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "check", "label": "Check mark" },
            { "value": "tick", "label": "Tick" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "fire", "label": "Fire" },
            { "value": "chat", "label": "Chat bubble" },
            { "value": "question", "label": "Question mark" },
            { "value": "lock", "label": "Lock" },
            { "value": "return", "label": "Return" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "plane", "label": "Plane" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "discount", "label": "Discount" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free delivery in 48h"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "text": "Free delivery in 48h" } },
        { "type": "feature", "settings": { "icon": "check", "text": "Partner Timekettle" } },
        { "type": "feature", "settings": { "icon": "star", "text": "Genuine Products" } },
        { "type": "feature", "settings": { "icon": "chat", "text": "UK Support" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
