      "blocks": {
        "b0": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/pp-m3-5867d5f1cb.jpg",
            "title": "Simultaneous Interpretation for In-depth Conversation",
            "text": "<p>Speak freely, no pauses needed. M3’s patented simultaneous interpretation tech instantly picks up your voice, seamlessly turning it into smooth, fluent translations.* The same pair of earbuds is for two people to wear.* Touch Simultaneous Interpretation: suitable for one-to-one in-depth communication, such as discussion, dating and so on.</p>"
          }
        },
        "b1": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/pp-m3-be20928bc3.jpg",
            "title": "One-way Translation of Speeches and Teaching",
            "text": "<p>This mode can recognize, pick up sentences automatically, and translate them into selected languages that plays continuously right in your ear. What's more, the script is automatically saved for your review anytime.* Place the phone close to the person speaking, and listen to the translation from earbud.* Listening Mode: suitable for one-way translation scenarios, e.g., lectures, speeches, etc.</p>"
          }
        },
        "b2": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/pp-m3-8a2c5a2a91.jpg",
            "title": "Two-way Interpretation for Short Questions and Answers",
            "text": "<p>In Speaker Mode, pop in one earbud and use your phone for quick chats—whether asking for directions or ordering food. No need to share your earbuds, just seamless conversations on the go. * Speaker Mode: suitable for one-on-one short communication, such as ordering food, asking for directions, etc.</p>"
          }
        }
      },
      "block_order": [
        "b0",
        "b1",
        "b2"
