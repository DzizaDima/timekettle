{% comment %}
  Контурные иконки Timekettle — один стиль: 24×24, stroke currentColor 1.5, без заливки.
  Цвет берётся от текста (в CSS — синий при наведении).

  Accepts:
  - icon: {String} возможности переводчика — online / offline / conversation / hands_free / meetings;
          преимущества магазина — uk_stock / delivery / partner / warranty

  Usage:
  {% render 'tk-icon', icon: 'offline' %}
{% endcomment %}
<svg
  class="tk-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'online' -%}
      <path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.3a9.5 9.5 0 0 1 13 0M8.6 15.6a5 5 0 0 1 6.8 0"/><circle cx="12" cy="19" r="1"/>
    {%- when 'offline' -%}
      <path d="M2.5 9a14 14 0 0 1 5.2-3M11 5a14 14 0 0 1 10.5 4M5.5 12.3a9.5 9.5 0 0 1 5-2.6M15.6 10.4a9.5 9.5 0 0 1 2.9 1.9M8.6 15.6a5 5 0 0 1 6.8 0M3 3l18 18"/><circle cx="12" cy="19" r="1"/>
    {%- when 'conversation' -%}
      <path d="M13.5 9.5A5.5 5.5 0 0 0 8 4H7.5A5.5 5.5 0 0 0 4.5 14.1V17l2.8-2H8a5.5 5.5 0 0 0 5.5-5.5Z"/><path d="M16.5 9.6a5 5 0 0 1 3 9.1V21l-2.6-1.8H16a5 5 0 0 1-4.3-2.4"/>
    {%- when 'hands_free' -%}
      <rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M2.5 8.5v4M21.5 8.5v4"/>
    {%- when 'meetings' -%}
      <circle cx="12" cy="7.5" r="2.5"/><circle cx="5" cy="10" r="2"/><circle cx="19" cy="10" r="2"/><path d="M7.5 19a4.5 4.5 0 0 1 9 0M2 18.5a3.2 3.2 0 0 1 4.3-3M22 18.5a3.2 3.2 0 0 0-4.3-3"/>
    {%- when 'uk_stock' -%}
      <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9M7.5 5.3l9 4.5"/>
    {%- when 'delivery' -%}
      <path d="M2.5 6h11v10h-11zM13.5 9.5h4l3 3.5V16h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'partner' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8.5 12.3 2.4 2.4 4.6-5"/>
    {%- when 'warranty' -%}
      <path d="M12 3 4.5 6v5.5c0 4.4 3.1 8 7.5 9.5 4.4-1.5 7.5-5.1 7.5-9.5V6L12 3Z"/><path d="m9 12 2 2 4-4"/>
  {%- endcase -%}
</svg>
