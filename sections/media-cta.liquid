{% comment %}
  "Not Sure Which Model You Need?" — two media cards side by side
  (photo with text overlay + a real playable video), two buttons below.
{% endcomment %}

{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #MediaCta-{{ section.id }} .page-width {
    max-width: 144rem;
    padding-left: 1.6rem;
    padding-right: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    #MediaCta-{{ section.id }} .page-width {
      padding-left: 6rem;
      padding-right: 6rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign video_alt = section.settings.video.alt | default: section.settings.video_description
  assign poster = section.settings.video.preview_image | default: section.settings.cover_image
  assign play_label = 'sections.video.load_video' | t: description: video_alt | escape
-%}

<section
  id="MediaCta-{{ section.id }}"
  class="media-cta color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    <div class="media-cta__row">
      <div class="media-cta__card media-cta__card--photo">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 750px) 66rem, 92vw',
              class: 'media-cta__image',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-apparel-1' | placeholder_svg_tag: 'media-cta__image media-cta__image--placeholder' }}
        {%- endif -%}
        <div class="media-cta__scrim"></div>
        <div class="media-cta__caption">
          {%- if section.settings.heading != blank -%}
            <h2 class="media-cta__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="media-cta__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="media-cta__card media-cta__card--video color-{{ section.settings.video_color_scheme }} gradient">
        {%- if section.settings.video_heading != blank -%}
          <h2 class="media-cta__video-heading">{{ section.settings.video_heading | escape }}</h2>
        {%- endif -%}

        <deferred-media class="media-cta__video deferred-media" data-media-id="{{ video_id }}">
          <button
            id="Deferred-Poster-MediaCta-{{ section.id }}"
            class="media-cta__poster deferred-media__poster"
            type="button"
            aria-label="{{ play_label }}"
          >
            {%- if poster != null -%}
              {{
                poster
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', class: 'media-cta__poster-image', alt: video_alt
              }}
            {%- else -%}
              {{ 'lifestyle-apparel-2' | placeholder_svg_tag: 'media-cta__poster-image media-cta__poster-image--placeholder' }}
            {%- endif -%}
            <span class="media-cta__play deferred-media__poster-button motion-reduce">
              <span class="svg-wrapper">
                {{- 'icon-play.svg' | inline_asset_content -}}
              </span>
            </span>
          </button>
          <template>
            {%- if section.settings.video == null and section.settings.video_url != null -%}
              {%- if section.settings.video_url.type == 'youtube' -%}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1"
                  class="js-youtube"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ section.settings.video_description | escape }}"
                ></iframe>
              {%- else -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
                  class="js-vimeo"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ section.settings.video_description | escape }}"
                ></iframe>
              {%- endif -%}
            {%- elsif section.settings.video != null -%}
              {{
                section.settings.video
                | video_tag: image_size: '1200x', autoplay: true, loop: false, controls: true, muted: false
              }}
            {%- endif -%}
          </template>
        </deferred-media>
      </div>
    </div>

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="media-cta__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a
            {% if section.settings.button_link_1 != blank %}
              href="{{ section.settings.button_link_1 }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button{% if section.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
          >
            {{ section.settings.button_label_1 | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            {% if section.settings.button_link_2 != blank %}
              href="{{ section.settings.button_link_2 }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button{% if section.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %} media-cta__btn"
          >
            {{ section.settings.button_label_2 | escape }}
            <span class="media-cta__btn-arrow svg-wrapper" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .media-cta {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .media-cta__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  .media-cta__card {
    position: relative;
    border-radius: 2.4rem;
    overflow: hidden;
  }

  .media-cta__card--photo {
    aspect-ratio: 5 / 4;
  }

  .media-cta__image,
  .media-cta__image--placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-cta__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.15) 55%, rgba(0, 0, 0, 0) 75%);
  }

  .media-cta__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.4rem;
    color: #fff;
  }

  .media-cta__heading {
    margin: 0 0 0.8rem;
    font-size: 2.8rem;
    line-height: 1.15;
  }

  .media-cta__text {
    margin: 0;
    max-width: 40rem;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .media-cta__card--video {
    display: flex;
    flex-direction: column;
    padding: 2.4rem;
  }

  .media-cta__video-heading {
    margin: 0 0 1.6rem;
    font-size: 2.8rem;
    line-height: 1.15;
  }

  .media-cta__video {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 1.6rem;
    overflow: hidden;
  }

  .media-cta__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
  }

  .media-cta__poster-image,
  .media-cta__poster-image--placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-cta__video[loaded] .media-cta__poster {
    display: none;
  }

  .media-cta__video video,
  .media-cta__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-cta__buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .media-cta__buttons .button {
    width: 100%;
    justify-content: center;
  }

  .media-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .media-cta__btn-arrow svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .media-cta__btn-arrow svg path {
    fill: currentColor;
  }

  @media screen and (min-width: 750px) {
    .media-cta__row {
      grid-template-columns: 1fr 1fr;
      gap: 2.4rem;
    }

    .media-cta__card--photo,
    .media-cta__card--video {
      aspect-ratio: 9 / 8;
    }

    .media-cta__card--video {
      padding: 3.2rem;
    }

    .media-cta__video {
      aspect-ratio: auto;
      flex: 1;
    }

    .media-cta__heading,
    .media-cta__video-heading {
      font-size: 3.6rem;
    }

    .media-cta__caption {
      padding: 3.2rem;
    }

    .media-cta__buttons {
      flex-direction: row;
      justify-content: center;
      margin-top: 4rem;
    }

    .media-cta__buttons .button {
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media + CTA duo",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Left card — photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not Sure Which Model You Need?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "We'll help you choose the right Timekettle for how you actually plan to use it."
    },
    {
      "type": "header",
      "content": "Right card — video"
    },
    {
      "type": "color_scheme",
      "id": "video_color_scheme",
      "label": "Card color",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Heading",
      "default": "How it works?"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video file"
    },
    {
      "type": "paragraph",
      "content": "Or use a YouTube / Vimeo link instead of an uploaded file:"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "YouTube or Vimeo URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image",
      "info": "Used for the YouTube / Vimeo option. Falls back to the video file's preview image."
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "Video alt text"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button 1 label",
      "default": "Compare Models"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_1",
      "label": "Button 1 — use secondary style",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 label",
      "default": "Contact Our UK Team"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_2",
      "label": "Button 2 — use secondary style",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Media + CTA duo"
    }
  ]
}
{% endschema %}
