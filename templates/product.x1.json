      "blocks": {
        "b0": {
          "type": "heading",
          "settings": {
            "heading": "8‑Hour Hub, 3‑Hour Earbuds, 5‑Minute Fast Charge",
            "heading_size": "h1"
          }
        },
        "b1": {
          "type": "text",
          "settings": {
            "text": "The hub runs for 8 hours. Earbuds last 3 hours of continuous translation. Need a boost? A 5‑minute quick charge gives you 1.5 hours of use – enough for a full client call or a team stand‑up. From morning briefings to late‑night cross‑time‑zone calls, X1 Meeting won’t let you down."
          }
        }
      },
      "block_order": [
        "b0",
        "b1"
      ]
    },
    "s18_languages_scrolling": {
      "type": "languages-scrolling",
      "settings": {
        "heading": "Covering the World, Accent by Accent.",
        "heading_size": "h1",
        "subheading": "52 languages and 106 regional accents — so you're always understood, no matter how you speak.",
