        "b0": {
          "type": "heading",
          "settings": {
            "heading": "Your Whole Team Speaks Freely – in Their Own Language.",
            "heading_size": "h1"
          }
        },
        "b1": {
          "type": "text",
          "settings": {
            "text": "Whether your team speaks Spanish, Mandarin, Arabic, or Portuguese, X1 Meeting has them covered. With 52 languages and 106 accents supported, plus free OTA additions, you can onboard partners, clients, and employees from anywhere. Absolute inclusivity for global business, education, and beyond."
          }
        }
      },
